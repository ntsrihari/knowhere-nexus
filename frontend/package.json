{
  "name": "knowhere-nexus-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "e2e:csp": "node e2e/csp-check.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "playwright": "1.63.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
