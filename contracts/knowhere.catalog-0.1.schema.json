{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.knowhere.invalid/knowhere.catalog-0.1.schema.json",
  "title": "knowhere.catalog 0.1",
  "description": "Server-managed application catalog read by the Nexus launcher (docs/CONTRACTS.md §1). Collector-specific data lives only under extensions.collector.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "revision", "source", "updatedAt", "apps"],
  "properties": {
    "schema": { "const": "knowhere.catalog" },
    "schemaVersion": { "type": "string", "pattern": "^0\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "revision": { "type": "integer", "minimum": 1 },
    "source": { "enum": ["file", "collector"] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "apps": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/app" } }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "icon", "audience"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "kind": { "enum": ["server", "android", "theme"] },
        "description": { "type": "string", "maxLength": 140 },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["builtin"],
          "properties": { "builtin": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" } }
        },
        "audience": { "enum": ["all", "admin"] },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route"],
          "properties": {
            "route": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" }
              ]
            }
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["containers"],
          "properties": {
            "containers": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$" }
            }
          }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,31}$" },
      "additionalProperties": { "type": "object" }
    }
  }
}
